  "mitigations": [
    {
      "id": "M1",
      "name": "Signature aggregation",
      "status": "not implemented or measured",
      "note": "Standard ML-DSA does not itself specify generic signature aggregation. A concrete, reviewed protocol and signer-accountability format are required."
    },
    {
      "id": "M2",
      "name": "Hybrid migration",
      "status": "design option only",
      "note": "A hybrid transition may protect selected interfaces, but retaining a classical authentication path is not full post-quantum authentication."
    },
    {
      "id": "M3",
      "name": "Off-chain signature batching or Merkle commitments",
      "status": "not computed",
      "note": "Payload depends on the attestation, audit-data availability, and proof format; no size reduction is assumed."
    },
